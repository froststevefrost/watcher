# Copy to .env and fill in. .env is git-ignored / not baked into the image.

# IP:port of the physical phone's network adb interface. Give the phone a
# static DHCP reservation by MAC on the UDM Pro first — otherwise a lease
# renewal changes this IP and the watcher silently stops reaching it.
ADB_HOST=192.168.1.XXX
ADB_PORT=5555

# One or more named regions to watch, semicolon-separated:
#   NAME:x1,y1,x2,y2;NAME2:x1,y1,x2,y2
# Any region changing color fires its own notification naming which one.
# Recalibrate if you point this at a different station/screen.
CROP_REGIONS=Front Charger:902,2048,1298,2160;Back Charger:902,2358,1298,2468

# How often to poll, in seconds
POLL_INTERVAL=30

# Your existing Apprise endpoint/URL — same one your homelab alerting uses
APPRISE_URL=https://alerts.example.com/notify/apprise

# Optional: minimum seconds between repeat notifications for the *same*
# region, in case the app renders a couple of slightly different frames
# in a row during a real transition
DEBOUNCE_SECONDS=5
