# Copy to .env and fill in. .env is git-ignored / not baked into the image.

  # IP:port of the physical phone's network adb interface. Give the phone a
  # static DHCP reservation by MAC on your router first — otherwise a lease
  # renewal changes this IP and the watcher silently stops reaching it.
  ADB_HOST=192.168.1.152
  ADB_PORT=5555

  # Timezone for this deployment. Drives the Mon-Fri 07:00-16:00 polling
  # window, so set this to *your* local timezone, not the container's
  # built-in default.
  TZ=America/New_York

  # One or more named regions to watch, semicolon-separated:
  #   NAME:x1,y1,x2,y2;NAME2:x1,y1,x2,y2
  # Any region changing color fires its own notification naming which one.
  # These are pixel coordinates specific to your phone's screen resolution
  # and charger screen layout — see README for how to find them.
  # ex: CROP_REGIONS=Front Charger:902,2048,1298,2160;Back Charger:902,2358,1298,2468
  CROP_REGIONS=Front Charger:0,0,0,0;Back Charger:0,0,0,0

  # How often to poll, in seconds
  POLL_INTERVAL=30

  # Your Apprise notify URL
  APPRISE_URL=https://apprise.example.com/notify/apprise

  # Replays the "tap away, tap back" gesture used to force-refresh status
  # before each sample: x1,y1;x2,y2 — also screen-specific, see README.
  REFRESH_TAPS=0,0;0,0

  # Optional: minimum seconds between repeat notifications for the *same*
  # region, in case the app renders a couple of slightly different frames
  # in a row during a real transition
  DEBOUNCE_SECONDS=5
